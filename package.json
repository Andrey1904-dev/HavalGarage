{
  "name": "haval-garage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HAVAL Гараж — каталог моделей HAVAL дилера АГАТ (Екатеринбург) и кредитный калькулятор. Бизнес-логика аннуитетных расчётов перенесена из архива GrantaCredit.zip (LadaGrantaCredit)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/test.mjs",
    "update:prices": "node scripts/update-prices.mjs",
    "import:price-list": "node scripts/import-price-list.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run smoke && npm run build"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide-react": "^1.54.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^26.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
